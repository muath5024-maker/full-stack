
# Database - non-sensitive defaults
DB_HOST=supabase-local
DB_PORT=5432
DB_NAME=multivendor
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_WORKERS_ENV

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=REPLACE_WITH_WORKERS_ENV
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO (S3 Compatible Storage)
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=REPLACE_WITH_WORKERS_ENV
MINIO_ROOT_PASSWORD=REPLACE_WITH_WORKERS_ENV
MINIO_BUCKET_NAME=multivendor-assets
AWS_ACCESS_KEY_ID=REPLACE_WITH_WORKERS_ENV
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_WORKERS_ENV
AWS_REGION=us-east-1

# Supabase
SUPABASE_URL=https://your-supabase-url
SUPABASE_KEY=REPLACE_WITH_WORKERS_ENV
SUPABASE_SERVICE_KEY=REPLACE_WITH_WORKERS_ENV

# AI Services

GEMINI_API_KEY=REPLACE_WITH_WORKERS_ENV

GROQ_API_KEY=REPLACE_WITH_WORKERS_ENV


# Database
DB_HOST=supabase-local
DB_PORT=5432
DB_NAME=multivendor
DB_USER=postgres
DB_PASSWORD=REPLACE_WITH_WORKERS_ENV

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=multivendor-assets
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
