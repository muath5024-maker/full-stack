# Worker environment example - copy to `workers/.env` and fill secrets (do NOT commit real secrets)

# Supabase
SUPABASE_URL=https://your-supabase-url
SUPABASE_KEY=REPLACE_WITH_SUPABASE_KEY
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_KEY

# AI Services
GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY

GROQ_API_KEY=REPLACE_WITH_GROQ_KEY

CREWAI_API_KEY=REPLACE_WITH_CREWAI_KEY
CREWAI_API_URL=https://api.crewai.example/v1/generate
GROQ_PROJECT_ID=your-groq-project-id
GROQ_DATASET=your-groq-dataset

# Internal auth between Gateway and Workers (set same value in Gateway env for calls)
WORKER_INTERNAL_KEY=REPLACE_WITH_INTERNAL_KEY

# Database
DB_HOST=supabase-local
DB_PORT=5432
DB_NAME=multivendor
DB_USER=postgres
DB_PASSWORD=your-db-password

# Redis
REDIS_URL=redis://redis:6379

# JWT
SECRET_KEY=your-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=multivendor-assets
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
